{
  "expo": {
    "name": "Al Dawri",
    "slug": "al-dawri",
    "scheme": "aldawri",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.aldawri.app",
      "infoPlist": {
        "CFBundleAllowMixedLocalizations": true,
        "ITSAppUsesNonExemptEncryption": false
      },
      "usesAppleSignIn": true
    },
    "android": {
      "package": "com.aldawri.app",
      "adaptiveIcon": {
        "backgroundColor": "#0B2E6F",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro",
      "output": "single"
    },
    "plugins": [
      "expo-router",
      "expo-localization",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0B2E6F",
          "image": "./assets/splash-icon.png",
          "imageWidth": 160
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "الدوري يحتاج الوصول لصورك عشان تضيف صورة حسابك. Al Dawri uses your photos to set your profile picture.",
          "cameraPermission": "الدوري يحتاج الكاميرا عشان تصوّر صورة حسابك. Al Dawri uses the camera to take your profile picture."
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#0B2E6F"
        }
      ],
      "expo-apple-authentication",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "الدوري يستخدم موقعك عشان يرتب لك الملاعب الأقرب، ويحدد موقع ملعبك إذا كنت صاحب ملعب. Al Dawri uses your location to show the nearest pitches and to pin your pitch on the map."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": false
    }
  }
}
